FROM bitnamilegacy/spark:3.4.2

USER root

RUN pip install --no-cache-dir \
    pyspark==3.4.2 \
    delta-spark==2.4.0 \
    mlflow \
    kafka-python \
    pandas==2.1.4 \
    numpy==1.26.4 \
    scikit-learn \
    jupyterlab \
    matplotlib \
    seaborn

# Delta Lake ve Kafka JAR'larını build sırasında indir → Spark classpath'e koy.
# spark.jars.packages Python kodu içinden set edilince JVM zaten ayağa kalkmış olur,
# bu yüzden --packages CLI flag'i veya direkt JAR kopyası gereklidir.
RUN echo "" > /tmp/dummy.py && \
    SPARK_LOCAL_IP=127.0.0.1 /opt/bitnami/spark/bin/spark-submit \
        --master "local[1]" \
        --packages "io.delta:delta-core_2.12:2.4.0,org.apache.spark:spark-sql-kafka-0-10_2.12:3.4.2" \
        --conf spark.driver.memory=512m \
        /tmp/dummy.py && \
    find /root/.ivy2/jars -name "*.jar" -exec cp {} /opt/bitnami/spark/jars/ \; && \
    echo "JAR'lar kopyalandı." || echo "ivy2 path bulunamadı, atlanıyor."

ENV MPLCONFIGDIR=/tmp/matplotlib

USER 1001
